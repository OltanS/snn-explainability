# LOCATIONS
MODEL_SAVE_DIR="/srv/scratch/A2RoboRes/Oltan/STScoreCAM/models"
DATA_SAVE_DIR="/srv/scratch/A2RoboRes/Oltan/STScoreCAM/data"

# MODEL/DATASET CONFIGURATIONS
MODEL_NAME="basic_snn"
ENABLE_BNTT=False
DATASET_NAME="dvs_gesture"  # Options: dvs_gesture, tiny_imagenet

# TRAINING CONFIGURATIONS
ON_DDP=True
# assuming n_time_bins=20
# Recommended batch size for dvs_gesture -> 16, recommended batch size for tiny_imagenet -> 64
BATCH_SIZE=16
EPOCHS=100
N_TIME_BINS=20
# 2e-3 recommended for dvs_gesture, 1e-3 for tiny_imagenet
LEARNING_RATE=2e-3
BETA=0.5

# LOGGING CONFIGURATIONS
SAVE_EVERY_N_EPOCHS=25