# LOCATIONS
MODEL_SAVE_DIR="./models_save"
DATA_SAVE_DIR="./data"

# MODEL/DATASET CONFIGURATIONS
MODEL_NAME="vgg11"  # Options: basic_snn, vgg11, resnet
ENABLE_BNTT=True
DATASET_NAME="tiny_imagenet"  # Options: dvs_gesture, tiny_imagenet, ucf101

# TRAINING CONFIGURATIONS
ON_DDP=False
# assuming n_time_bins=20
# Recommended batch size for dvs_gesture, ucf101 -> 16, recommended batch size for tiny_imagenet -> 64
BATCH_SIZE=16
EPOCHS=90
N_TIME_BINS=10
# ratio of frames randomly masked
MASK_RATIO=0

LEARNING_RATE=1e-3
WEIGHT_DECAY=1e-3
BETA=0.99

# LOGGING CONFIGURATIONS
SAVE_EVERY_N_EPOCHS=30
