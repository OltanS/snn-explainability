# LOCATIONS
MODEL_SAVE_DIR="/srv/scratch/A2RoboRes/Oltan/STScoreCAM/models"
DATA_SAVE_DIR="/srv/scratch/A2RoboRes/Oltan/STScoreCAM/data"

# MODEL/DATASET CONFIGURATIONS
MODEL_NAME="resnet"  # Options: basic_snn, vgg11, resnet
ENABLE_BNTT=True
DATASET_NAME="dvs_gesture"  # Options: dvs_gesture, tiny_imagenet, ucf101

# TRAINING CONFIGURATIONS
ON_DDP=True
# assuming n_time_bins=20
# Recommended batch size for dvs_gesture, ucf101 -> 16, recommended batch size for tiny_imagenet -> 64
BATCH_SIZE=8
EPOCHS=100
N_TIME_BINS=20
# ratio of frames randomly masked
MASK_RATIO=0.25

LEARNING_RATE=1e-4
WEIGHT_DECAY=1e-2
BETA=0.75

# LOGGING CONFIGURATIONS
SAVE_EVERY_N_EPOCHS=25
