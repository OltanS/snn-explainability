# LOCATIONS
MODEL_SAVE_DIR="./models_save"
DATA_SAVE_DIR="./data"

# MODEL/DATASET CONFIGURATIONS
# simple_snn, vgg11, resnet
MODEL_NAME="simple_snn"
# normalization options: bntt, layernorm, batchnorm, none
NORM_TYPE="none"
# dvs_gesture, tiny_imagenet, ucf101, nmnist, cifar10_dvs
DATASET_NAME="cifar10_dvs"

# TRAINING CONFIGURATIONS
ON_DDP=False
# assuming n_time_bins=20
# Recommended batch size for dvs_gesture, ucf101 -> 16, recommended batch size for tiny_imagenet -> 64, NMNIST -> 512
BATCH_SIZE=16
EPOCHS=60
N_TIME_BINS=20
# ratio of frames randomly masked
MASK_RATIO=0

LEARNING_RATE=1e-3
WEIGHT_DECAY=1e-4
BETA=0.75

# LOGGING CONFIGURATIONS
SAVE_EVERY_N_EPOCHS=10

